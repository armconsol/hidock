// Tauri IPC commands for notes

use crate::db::{
    types::{InsertNote, Note, UpdateNote},
    Database,
};
use std::sync::Mutex;
use tauri::State;

use super::AppState;

/// List notes with pagination
#[tauri::command]
pub async fn list_notes(
    limit: Option<i64>,
    offset: Option<i64>,
    state: State<'_, AppState>,
) -> Result<Vec<Note>, String> {
    let db = state
        .db
        .lock()
        .map_err(|e| format!("Database lock error: {}", e))?;

    db.list_notes(limit.unwrap_or(20), offset.unwrap_or(0))
        .map_err(|e| format!("Failed to list notes: {}", e))
}

/// List notes by folder with pagination
#[tauri::command]
pub async fn list_notes_by_folder(
    folder_id: String,
    limit: Option<i64>,
    offset: Option<i64>,
    state: State<'_, AppState>,
) -> Result<Vec<Note>, String> {
    let db = state
        .db
        .lock()
        .map_err(|e| format!("Database lock error: {}", e))?;

    db.list_notes_by_folder(&folder_id, limit.unwrap_or(20), offset.unwrap_or(0))
        .map_err(|e| format!("Failed to list notes by folder: {}", e))
}

/// Get a note by ID
#[tauri::command]
pub async fn get_note(note_id: String, state: State<'_, AppState>) -> Result<Option<Note>, String> {
    let db = state
        .db
        .lock()
        .map_err(|e| format!("Database lock error: {}", e))?;

    db.get_note(&note_id)
        .map_err(|e| format!("Failed to get note: {}", e))
}

/// Create a new note
#[tauri::command]
pub async fn create_note(
    id: String,
    title: String,
    content: Option<String>,
    folder_id: Option<String>,
    audio_url: Option<String>,
    duration: Option<String>,
    rating: Option<i32>,
    state: State<'_, AppState>,
) -> Result<Note, String> {
    let db = state
        .db
        .lock()
        .map_err(|e| format!("Database lock error: {}", e))?;

    let note = InsertNote {
        id,
        title,
        content,
        folder_id,
        audio_url,
        duration,
        rating,
    };

    db.insert_note(&note)
        .map_err(|e| format!("Failed to create note: {}", e))
}

/// Update an existing note
#[tauri::command]
pub async fn update_note(
    id: String,
    title: Option<String>,
    content: Option<String>,
    folder_id: Option<String>,
    audio_url: Option<String>,
    duration: Option<String>,
    rating: Option<i32>,
    state: State<'_, AppState>,
) -> Result<Note, String> {
    let db = state
        .db
        .lock()
        .map_err(|e| format!("Database lock error: {}", e))?;

    let update = UpdateNote {
        title,
        content,
        folder_id,
        audio_url,
        duration,
        rating,
    };

    db.update_note(&id, &update)
        .map_err(|e| format!("Failed to update note: {}", e))
}

/// Delete a note
#[tauri::command]
pub async fn delete_note(note_id: String, state: State<'_, AppState>) -> Result<(), String> {
    let db = state
        .db
        .lock()
        .map_err(|e| format!("Database lock error: {}", e))?;

    db.delete_note(&note_id)
        .map_err(|e| format!("Failed to delete note: {}", e))
}

/// Count total notes
#[tauri::command]
pub async fn count_notes(state: State<'_, AppState>) -> Result<i64, String> {
    let db = state
        .db
        .lock()
        .map_err(|e| format!("Database lock error: {}", e))?;

    db.count_notes()
        .map_err(|e| format!("Failed to count notes: {}", e))
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::db::Database;

    fn setup_db() -> Database {
        Database::new_in_memory().expect("Failed to create test database")
    }

    fn create_test_note(id: &str, title: &str) -> InsertNote {
        InsertNote {
            id: id.to_string(),
            title: title.to_string(),
            content: Some("Test content".to_string()),
            folder_id: None,
            audio_url: None,
            duration: None,
            rating: None,
        }
    }

    #[tokio::test]
    async fn test_create_note_command() {
        let db = setup_db();
        let app_state = AppState { db: Mutex::new(db) };
        let state = State::from(&app_state);

        let result = create_note(
            "note-1".to_string(),
            "Test Note".to_string(),
            Some("Content".to_string()),
            None,
            None,
            None,
            Some(5),
            state,
        )
        .await;

        assert!(result.is_ok());
        let note = result.unwrap();
        assert_eq!(note.id, "note-1");
        assert_eq!(note.title, "Test Note");
        assert_eq!(note.rating, Some(5));
    }

    #[tokio::test]
    async fn test_get_note_command() {
        let db = setup_db();
        let note = create_test_note("note-1", "Test Note");
        db.insert_note(&note).unwrap();

        let app_state = AppState { db: Mutex::new(db) };
        let state = State::from(&app_state);

        let result = get_note("note-1".to_string(), state).await;

        assert!(result.is_ok());
        let retrieved = result.unwrap();
        assert!(retrieved.is_some());
        assert_eq!(retrieved.unwrap().id, "note-1");
    }

    #[tokio::test]
    async fn test_get_nonexistent_note_command() {
        let db = setup_db();
        let app_state = AppState { db: Mutex::new(db) };
        let state = State::from(&app_state);

        let result = get_note("nonexistent".to_string(), state).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_none());
    }

    #[tokio::test]
    async fn test_list_notes_command() {
        let db = setup_db();
        db.insert_note(&create_test_note("note-1", "Note 1"))
            .unwrap();
        db.insert_note(&create_test_note("note-2", "Note 2"))
            .unwrap();
        db.insert_note(&create_test_note("note-3", "Note 3"))
            .unwrap();

        let app_state = AppState { db: Mutex::new(db) };
        let state = State::from(&app_state);

        let result = list_notes(Some(10), Some(0), state).await;

        assert!(result.is_ok());
        let notes = result.unwrap();
        assert_eq!(notes.len(), 3);
    }

    #[tokio::test]
    async fn test_list_notes_with_pagination() {
        let db = setup_db();
        for i in 1..=5 {
            db.insert_note(&create_test_note(
                &format!("note-{}", i),
                &format!("Note {}", i),
            ))
            .unwrap();
        }

        let app_state = AppState { db: Mutex::new(db) };
        let state1 = State::from(&app_state);
        let state2 = State::from(&app_state);

        // First page
        let page1 = list_notes(Some(2), Some(0), state1).await.unwrap();
        assert_eq!(page1.len(), 2);

        // Second page
        let page2 = list_notes(Some(2), Some(2), state2).await.unwrap();
        assert_eq!(page2.len(), 2);
    }

    #[tokio::test]
    async fn test_update_note_command() {
        let db = setup_db();
        db.insert_note(&create_test_note("note-1", "Original Title"))
            .unwrap();

        let app_state = AppState { db: Mutex::new(db) };
        let state = State::from(&app_state);

        let result = update_note(
            "note-1".to_string(),
            Some("Updated Title".to_string()),
            Some("Updated content".to_string()),
            None,
            None,
            None,
            Some(4),
            state,
        )
        .await;

        assert!(result.is_ok());
        let updated = result.unwrap();
        assert_eq!(updated.title, "Updated Title");
        assert_eq!(updated.content, Some("Updated content".to_string()));
        assert_eq!(updated.rating, Some(4));
    }

    #[tokio::test]
    async fn test_update_nonexistent_note_command() {
        let db = setup_db();
        let app_state = AppState { db: Mutex::new(db) };
        let state = State::from(&app_state);

        let result = update_note(
            "nonexistent".to_string(),
            Some("Title".to_string()),
            None,
            None,
            None,
            None,
            None,
            state,
        )
        .await;

        assert!(result.is_err());
        assert!(result.unwrap_err().contains("Note not found"));
    }

    #[tokio::test]
    async fn test_delete_note_command() {
        let db = setup_db();
        db.insert_note(&create_test_note("note-1", "Test Note"))
            .unwrap();

        let app_state = AppState { db: Mutex::new(db) };
        let state1 = State::from(&app_state);
        let state2 = State::from(&app_state);

        let delete_result = delete_note("note-1".to_string(), state1).await;
        assert!(delete_result.is_ok());

        let get_result = get_note("note-1".to_string(), state2).await;
        assert!(get_result.is_ok());
        assert!(get_result.unwrap().is_none());
    }

    #[tokio::test]
    async fn test_delete_nonexistent_note_command() {
        let db = setup_db();
        let app_state = AppState { db: Mutex::new(db) };
        let state = State::from(&app_state);

        let result = delete_note("nonexistent".to_string(), state).await;

        assert!(result.is_err());
        assert!(result.unwrap_err().contains("Note not found"));
    }

    #[tokio::test]
    async fn test_count_notes_command() {
        let db = setup_db();
        db.insert_note(&create_test_note("note-1", "Note 1"))
            .unwrap();
        db.insert_note(&create_test_note("note-2", "Note 2"))
            .unwrap();

        let app_state = AppState { db: Mutex::new(db) };
        let state = State::from(&app_state);

        let result = count_notes(state).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap(), 2);
    }

    #[tokio::test]
    async fn test_list_notes_by_folder_command() {
        let db = setup_db();

        // Create a folder first
        db.insert_folder("folder-1", "Work").unwrap();

        // Create notes in the folder
        let note1 = InsertNote {
            id: "note-1".to_string(),
            title: "Work Note 1".to_string(),
            content: None,
            folder_id: Some("folder-1".to_string()),
            audio_url: None,
            duration: None,
            rating: None,
        };
        let note2 = InsertNote {
            id: "note-2".to_string(),
            title: "Work Note 2".to_string(),
            content: None,
            folder_id: Some("folder-1".to_string()),
            audio_url: None,
            duration: None,
            rating: None,
        };

        db.insert_note(&note1).unwrap();
        db.insert_note(&note2).unwrap();

        let app_state = AppState { db: Mutex::new(db) };
        let state = State::from(&app_state);

        let result = list_notes_by_folder("folder-1".to_string(), Some(10), Some(0), state).await;

        assert!(result.is_ok());
        let notes = result.unwrap();
        assert_eq!(notes.len(), 2);
        assert!(notes
            .iter()
            .all(|n| n.folder_id == Some("folder-1".to_string())));
    }
}
